# Firebase project config — copy this file to .env.local and fill in real values
# from your Firebase project settings (console.firebase.google.com > Project
# Settings > General > Your apps > SDK setup and configuration).
#
# .env.local is gitignored — never commit real Firebase keys.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email of the store owner/admin account (created via Firebase Auth) that is
# allowed into /admin. See src/config/admin.ts.
VITE_ADMIN_EMAIL=
