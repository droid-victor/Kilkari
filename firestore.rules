rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI and firebase.json — see README)

service cloud.firestore {
  match /databases/{database}/documents {

    // Only this email may write. Firebase Auth custom claims would be a
    // stronger long-term approach if multiple staff accounts are added later;
    // for a single-owner store, matching the signed-in user's email is
    // sufficient and simple to audit.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == "khan.arslanaziz@gmail.com";
    }

    // Products: public read (storefront), admin-only write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: a signed-in customer can create their own order and read only
    // their own orders (matched by userId); the admin can read/update/delete
    // any order (e.g. to advance order status).
    match /orders/{orderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Customer profiles: a signed-in user can create/read/update only their
    // own profile document (doc id == their uid). Admin can read all.
    match /customers/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Everything else: locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
