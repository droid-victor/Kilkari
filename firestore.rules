rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI and firebase.json — see README)

service cloud.firestore {
  match /databases/{database}/documents {

    // Only this email may write. Firebase Auth custom claims would be a
    // stronger long-term approach if multiple staff accounts are added later;
    // for a single-owner store, matching the signed-in user's email is
    // sufficient and simple to audit.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == "OWNER_EMAIL_PLACEHOLDER";
    }

    // Products: public read (storefront), admin-only write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: created by anyone (checkout is unauthenticated in this app),
    // but only the admin can read the list or update order status.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Everything else: locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
